# ---------------------------------------------------------------------------
# Configuración de revolico-bot
#
# IMPORTANTE: aquí NO van usuario ni contraseña de Revolico. La autenticación
# se hace exclusivamente con sesion.json, generado por login manual mediante
# `node src/capture-session.js`. El bot nunca lee ni almacena credenciales.
# ---------------------------------------------------------------------------

# Notificaciones por Telegram (opcionales).
# Si se dejan vacías, el bot funciona igual y solo registra una advertencia.
# TELEGRAM_TOKEN lo entrega @BotFather al crear el bot.
TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID es el id del chat destino (puede obtenerse con @userinfobot).
TELEGRAM_CHAT_ID=

# Ruta a un Chromium ya instalado en el sistema (opcional).
# Déjalo vacío para usar el que descarga Playwright, que es lo normal.
# Solo sirve si tu VPS ya trae Chromium y prefieres no descargar otro.
# CHROMIUM_PATH=/usr/bin/chromium
